{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash

set -euo pipefail

# Brewfileのhash値をコメントに含めることでBrewfileに変更があった時にこのスクリプトを実行する
# Brewfile: {{ include (joinPath .chezmoi.sourceDir "packages/Brewfile") | sha256sum }}

if ! command -v brew &> /dev/null; then
  echo "Installing Homebrew ..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

echo "Installing packages with Homebrew ..."
# GitHubのCIの時はBrewFileからのinstallをしない
{{ if or (eq .chezmoi.username "takahiro.futagawa" ) (eq .chezmoi.username "futabooo") }}
brewfile="{{ .chezmoi.homeDir }}/packages/Brewfile"

# 新しいHomebrewは非公式tapをtrustしないとformulaやコマンドを読み込まない
# Brewfileに書いてあるtapは自分で管理しているものなのでまとめてtrustする
if brew trust --help > /dev/null 2>&1; then
  while IFS= read -r tap; do
    brew trust --tap "$tap"
  done < <(sed -n 's/^tap "\([^"]*\)".*/\1/p' "$brewfile")
fi

brew bundle --file="$brewfile"
{{ end }}

{{ end -}}