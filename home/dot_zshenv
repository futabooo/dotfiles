# https://wiki.archlinux.jp/index.php/XDG_Base_Directory
# macOSはデフォルト~/Library/Application\ Support/
# 一部のアプリケーションは$XDG_CONFIG_HOMEを見てくれる
export XDG_CONFIG_HOME="${HOME}/.config"

# zshの設定ファイルを読み込むpathを設定
# ${HOME} -> ${HOME}/zsh
export ZDOTDIR="${XDG_CONFIG_HOME}/zsh"

# zshの起動速度を計測する
if (which zprof > /dev/null) ;then
  zprof
fi

# ZDOTDIR が環境変数で引き継がれた子の zsh は ~/.zshenv ではなく $ZDOTDIR/.zshenv だけを
# 読む。どちらから起動しても同じ設定になるよう、環境変数の設定は $ZDOTDIR/.zshenv に置き、
# ここからも読み込む。
if [[ -f "${ZDOTDIR}/.zshenv" ]]; then
  source "${ZDOTDIR}/.zshenv"
fi
