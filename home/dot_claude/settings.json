{
  "agentPushNotifEnabled": true,
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "firebase@firebase": true,
    "frontend-design@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "chrome-devtools-plugins": {
      "source": {
        "repo": "ChromeDevTools/chrome-devtools-mcp",
        "source": "github"
      }
    },
    "firebase": {
      "source": {
        "repo": "firebase/firebase-tools",
        "source": "github"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "$HOME/.claude/hooks/open-plan-in-mo.py",
            "timeout": 20,
            "type": "command"
          }
        ],
        "matcher": "ExitPlanMode"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '/Users/futabooo/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "model": "fable[1m]",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "medium"
    },
    "claude-opus-5": {
      "effortLevel": "medium"
    }
  },
  "permissions": {
    "allow": [
      "Bash(gh-ro:*)",
      "mcp__pencil"
    ],
    "ask": [
      "Bash(gh api *)",
      "Bash(gh repo edit *)",
      "Bash(gh ruleset *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(wrangler *)",
      "Bash(bunx wrangler *)",
      "Bash(npx wrangler *)",
      "Bash(bun run deploy*)"
    ]
  },
  "plansDirectory": "./.plans",
  "sandbox": {
    "allowUnsandboxedCommands": false,
    "enabled": true,
    "failIfUnavailable": true
  },
  "statusLine": {
    "command": "~/.claude/c-c-statusline",
    "type": "command"
  }
}